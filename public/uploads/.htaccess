# ==============================================================================
# BẢO MẬT THƯ MỤC UPLOADS: CHỐNG THỰC THI MÃ ĐỘC PHP / SCRIPT
# ==============================================================================

# Vô hiệu hóa thực thi engine PHP trong thư mục tĩnh
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Chặn thực thi CGI & Tắt duyệt cây thư mục
Options -ExecCGI -Indexes

# Không cho phép xử lý các phần mở rộng nguy hiểm
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py .sh

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|exe|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

