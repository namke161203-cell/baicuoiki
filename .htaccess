# ==============================================================================
# HỆ THỐNG CẤU HÌNH DEVOPS & BẢO MẬT APACHE (.HTACCESS)
# ==============================================================================

# 1. URL REWRITE & FRONT CONTROLLER PATTERN
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /duan/

    # Chặn truy cập trái phép vào các thư mục và tệp tin hệ thống nhạy cảm
    RewriteRule ^(\.git|\.env|\.cursorrules|config|tests) - [F,L]

    # Nếu tệp tin hoặc thư mục thực tế tồn tại, cho phép tải trực tiếp
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Điều hướng mọi yêu cầu còn lại về Front Controller index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# 2. TỐI ƯU HIỆU NĂNG: NÉN DỮ LIỆU GZIP (MOD_DEFLATE)
# Giảm dung lượng truyền tải từ 60% đến 70%
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# 3. TỐI ƯU HIỆU NĂNG: BỘ NHỚ ĐỆM TRÌNH DUYỆT (BROWSER CACHING / MOD_EXPIRES)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"

    # Hình ảnh sản phẩm & Media: Cache 1 tháng
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript: Cache 1 tuần
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/x-javascript "access plus 1 week"
</IfModule>

# 4. BẢO MẬT HỆ THỐNG: SECURITY HEADERS
<IfModule mod_headers.c>
    # Chống MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    # Kích hoạt bộ lọc XSS của trình duyệt
    Header set X-XSS-Protection "1; mode=block"
    # Chống Clickjacking (Click chèn iframe từ site khác)
    Header set X-Frame-Options "SAMEORIGIN"
    # Giới hạn thông tin Referrer
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. TẮT DUYỆT CÂY THƯ MỤC TRỰC TIẾP (DIRECTORY BROWSING)
Options -Indexes

